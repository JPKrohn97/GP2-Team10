  m_Script: {fileID: 11500000, guid: f37d456f0635af049bd41c0a4c505920, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  RandomLines1:
  - What is that creature?
  - That lizard looks so mean.
  - A reptile wielding a sword?
  RandomLines2:
  - Will it attack me?
  - Oh... I think it's angry.
  - That's a discusting creature.
  RandomLines3:
  - How could I defend myself?
  - Can I fight it?
  RandomLines4:
  - 'When did I grew claws? '
  - Are these claws?
  RandomLines5:
  - ' '
  RandomLines6:
  - (Use the claw button to attack)
