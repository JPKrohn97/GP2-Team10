  m_Script: {fileID: 11500000, guid: f37d456f0635af049bd41c0a4c505920, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  RandomLines1:
  - WHAT IS THAT BEHEMOTH?!?!
  - IS THAT A GIANT?!?!?!
  - ARE THE LIZARDS TURNING INTO STONE?!?!?!
  RandomLines2:
  - 'Disemboied voice: Behold the earth-bonded-kin, apex of evolution.'
  RandomLines3:
  - 'Disemboied voice: Surrender, you unscrupulous misfit. This cannot continue any
    longer.'
  - 'Disemboied voice: This insurrection must be quelled, subject. Don''t pursue
    further.'
  - 'Disemboied voice: Subject, your disturbances has been noticed, you will succumb.'
  - 'Disemboied voice: Return to slumber, you are slowing down progress. Subject,
    you won''t overpower it.'
  RandomLines4:
  - There's no way I can defeat it, but there's no other way to escape...
  RandomLines5:
  - ' '
  RandomLines6:
  - ' '
