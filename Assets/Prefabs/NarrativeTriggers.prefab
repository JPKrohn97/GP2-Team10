  m_Script: {fileID: 11500000, guid: f37d456f0635af049bd41c0a4c505920, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  RandomLines1:
  - I can't believe I survived. Its power will allow me to explore further and find
    a way out.
  RandomLines2:
  - 'Disemboied voice: What a waste of potential, you are but a broken imitation.'
  - 'Disemboied voice: Delaying the inevitable will only make you suffer even more.'
  - 'Disemboied voice: My kin are prepared for your arrival, you have no chance.'
  RandomLines3:
  - 'Disemboied voice: In time, we won''t even need your bunch. The Reptiloids will
    inherit the earth and you will be forgoten along side the Surface-scum.'
  RandomLines4:
  - '''Surface-scum''?'
  - '''Reptiloids''?'
  - They won't need 'us'?
  RandomLines5:
  - ' '
  RandomLines6:
  - ' '
